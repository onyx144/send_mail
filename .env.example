# Runtime
APP_NAME="Mail Sender"
DATABASE_URL="sqlite+aiosqlite:///./data/mail_sender.sqlite3"
AUTO_SENDER_ENABLED=false
AUTO_INBOX_ENABLED=false
AUTO_PARSE_ENABLED=false

# Mail server defaults
MAIL_SMTP_HOST="mx1.example.com"
MAIL_SMTP_PORT=111
MAIL_SMTP_SSL=true
MAIL_IMAP_HOST="mx1.example.com"
  MAIL_IMAP_PORT=111
MAIL_IMAP_SSL=true
MAIL_POP3_HOST="mx1.example.com"
MAIL_POP3_PORT=111
MAIL_POP3_SSL=true

# Add/update accounts here. Do NOT commit real passwords.
# Put the three Questalize mailboxes here locally later.
MAIL_ACCOUNTS_JSON='[
  {"email":"manager@example.com","password":"CHANGE_ME","display_name":"Example Manager"},
  {"email":"advertising@example.com","password":"CHANGE_ME","display_name":"Example Advertising"},
  {"email":"information@example.com","password":"CHANGE_ME","display_name":"Example Information"}
]'

# Parser target. You will provide the real website later.
PARSE_START_URL=""
PARSE_MAX_PAGES=1
PARSE_LINK_SELECTOR="a"
PARSE_NEXT_SELECTOR="a[rel='next']"
PARSE_TIMEOUT_SECONDS=25

# Sending rules
MIN_SUBSCRIBERS_PLAN_NOW=3000
SEND_INTERVAL_BETWEEN_EMAILS_SECONDS=600
SEND_INTERVAL_PER_ACCOUNT_SECONDS=3600
OUTBOUND_SUBJECT=""
OUTBOUND_BODY_FILE="prompts/first_message.txt"

# Telegram bot integration. Fill later.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_IDS_JSON='[]'
PUBLIC_BASE_URL=""
